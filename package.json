{
  "name": "proof-face",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:all": "concurrently --kill-others --names CHAIN,API,WEB --prefix-colors yellow,cyan,green \"npm run chain\" \"npm run api\" \"npm run dev\"",
    "chain": "node blockchain/server.mjs",
    "api": ".venv/bin/python -m uvicorn backend.api:app --host 127.0.0.1 --port 8000 --reload",
    "pipeline": ".venv/bin/python -m backend.cli",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern data",
    "test": ".venv/bin/python -m pytest -q && node --test blockchain/test/*.test.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "next": "^16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "hardhat": "^3.15.0",
    "react-server-dom-webpack": "19.2.6",
    "solc": "^0.8.36",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
