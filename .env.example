# Required: genuine reverse-image search. Enable the Cloud Vision API and create an API key.
GOOGLE_VISION_API_KEY=

# Local defaults used by the bundled EVM and API.
CHAIN_API_URL=http://127.0.0.1:8546
PUBLIC_API_URL=http://localhost:8000

# If true, reject provider matches unless the remote image can also be downloaded and
# independently matched with SFace. Some social CDNs block automated downloads.
REQUIRE_FACE_CONFIRMATION=false
VISION_TIMEOUT_SECONDS=45
